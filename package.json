{
  "name": "@chamevo/mcp",
  "version": "0.3.2",
  "description": "MCP server for the Chamevo WordPress plugin — manage products, orders, print profiles, and pricing rules from Claude and other AI assistants",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chamevo/chamevo-mcp.git"
  },
  "homepage": "https://github.com/Chamevo/chamevo-mcp#readme",
  "bugs": {
    "url": "https://github.com/Chamevo/chamevo-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "chamevo",
    "wordpress",
    "woocommerce",
    "product-customization"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chamevo-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
